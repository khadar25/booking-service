<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="create-show-table" author="system">
        <createTable tableName="show">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="movie_id" type="bigint"/>
            <column name="screen_id" type="bigint"/>
            <column name="show_date" type="date"/>
            <column name="show_time" type="time"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="show"
            baseColumnNames="movie_id"
            referencedTableName="movie"
            referencedColumnNames="id"
            constraintName="fk_show_movie"/>
        <addForeignKeyConstraint
            baseTableName="show"
            baseColumnNames="screen_id"
            referencedTableName="screen"
            referencedColumnNames="id"
            constraintName="fk_show_screen"/>
    </changeSet>

</databaseChangeLog>
